#!/bin/sh
url=""
for a in "$@"; do
    case "$a" in
        -*) continue ;;
    esac
    url="$a"
    break
done
if [ -z "$url" ]; then
    echo "usage: wget <url>" >&2
    exit 1
fi
case "$url" in
    http://*|https://*) ;;
    *) url="https://$url" ;;
esac
out=${url%%\?*}
out=${out%/}
out=${out##*/}
[ -n "$out" ] || out="index.html"
exec /usr/bin/ppgw -downURL "$url" -output "$out"
