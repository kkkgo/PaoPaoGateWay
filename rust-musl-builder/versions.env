#
# Pinned upstream versions for the musl cross toolchain. Everything here is
# fetched from the project's own official server -- no mirrors, no third party
# build scripts. Bump a version and its sha256 in checksums.txt together.
#
#   binutils, gcc, gmp, mpfr, mpc   ftp.gnu.org
#   musl                            musl.libc.org
#   linux (headers only)            cdn.kernel.org

BINUTILS_VER=2.47
GCC_VER=16.2.0
GMP_VER=6.3.0
MPFR_VER=4.2.2
MPC_VER=1.4.1
MUSL_VER=1.2.6
LINUX_VER=7.1.7
